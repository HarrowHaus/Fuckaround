# Large sample libraries and built tools — downloaded/built by setup, never committed
samples/
tools/
# Intermediate audio/MIDI (multi-GB, single shared path overwritten by
# whichever song rendered last) — regenerated by the pipeline, no
# archival value
stems/
midi/*.mid
*.pyc
__pycache__/
# raw WAV masters exceed GitHub limits — FLAC + MP3 are committed instead
mix/*.wav
mix/preview.*
corpus/raw/
corpus/raw_modern/
reaper/Backups/
jam/candidates/*/*.wav
jam/candidates/*/*.mid
jam/candidates/*/*_di.wav
jam/candidates/*/*_amp.wav
